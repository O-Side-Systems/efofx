# Copy to .env for local development.

# Base URL of the Rust core (apps/efofx-core). The widget appends `/v1`
# itself — do not include the version prefix here.
VITE_API_URL=http://localhost:8080

# Demo tenant API key for the test-embed harness. Mint via
# `POST /v1/me/api-keys:rotate` against a provisioned dashboard tenant,
# or via the seeded fixture.
VITE_DEMO_API_KEY=
