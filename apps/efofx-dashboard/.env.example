# Copy to .env for local development.

# Base URL of the Rust core (apps/efofx-core). The dashboard's API client
# appends `/v1` itself — do not include the version prefix here.
VITE_API_BASE_URL=http://localhost:8080

# Supabase project — same project as the Rust core's EFOFX_SUPABASE__URL.
VITE_SUPABASE_URL=https://qzdgqepcdaoyigrgtlzv.supabase.co

# Supabase anon (public) key. Never use the service_role key in the
# dashboard.
VITE_SUPABASE_ANON_KEY=
