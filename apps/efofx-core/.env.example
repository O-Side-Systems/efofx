# Copy to .env for local development. All values override config/efofx-core.toml.
# Nested keys use double-underscore: supabase.url → EFOFX_SUPABASE__URL.

# Mongo
EFOFX_MONGO__URI=mongodb://localhost:27017
EFOFX_MONGO__DB_NAME=efofx

# Supabase (auth-only). The Rust core verifies JWTs against the Supabase
# JWKS endpoint at {url}/auth/v1/.well-known/jwks.json — no service_role
# key needed and none should be supplied.
EFOFX_SUPABASE__URL=https://qzdgqepcdaoyigrgtlzv.supabase.co
EFOFX_SUPABASE__ISSUER=https://qzdgqepcdaoyigrgtlzv.supabase.co/auth/v1
EFOFX_SUPABASE__AUDIENCE=authenticated
EFOFX_SUPABASE__JWKS_REFRESH_SECONDS=900

# Root key for BYOK encryption. Generate with:
#   openssl rand -base64 32
EFOFX_CRYPTO__MASTER_KEY=

# Outbound email (Resend). Leave blank for local dev — the runtime wires a
# no-op sender that logs instead of sending. Use a Resend test-mode key
# (re_...) for live email testing.
EFOFX_EMAIL__RESEND_API_KEY=
EFOFX_EMAIL__FROM_ADDRESS=noreply@efofx.local
EFOFX_EMAIL__APP_BASE_URL=http://localhost:8080

# Logging
RUST_LOG=info,efofx_core=debug
